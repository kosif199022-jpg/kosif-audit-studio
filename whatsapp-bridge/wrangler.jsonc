{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wa-kosif",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "observability": { "enabled": true },
  // SHA-256 of every accepted API key, comma separated (the keys themselves are never stored).
  "vars": { "API_KEY_SHA256": "dedad5f0d3a07dfdec6aa0b7d1739ef94ba29d81abb429f681e5efb69d684097,5e232ccf2246c42bb5b8629f449fa992b92ad26e7160f6cbf6055f54858bc82a" },
  "containers": [
    {
      "class_name": "WaBridge",
      "image": "./container/Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "wa-kosif-files" }],
  "durable_objects": {
    "bindings": [{ "name": "WA", "class_name": "WaBridge" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WaBridge"] }]
}
