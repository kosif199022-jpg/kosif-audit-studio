{
  "name": "kosif-audit-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "quality": "node scripts/repository-health.mjs",
    "quality:bundle": "node scripts/bundle-budget.mjs",
    "vendor:mp3": "node scripts/vendor-mp3-encoder.mjs",
    "build": "npm run quality && npm run vendor:mp3 && vite build && npm run quality:bundle && node scripts/prepare-sites-build.mjs",
    "build:ai": "npm run quality && npm run vendor:mp3 && vite build --config vite.ai-studio.config.mjs",
    "db:guards": "node scripts/generate-d1-guards.mjs",
    "preview": "vite preview",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "build:cloudflare": "npm run build && node --test tests/*.test.mjs && node scripts/prepare-cloudflare-build.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "docx": "9.5.1",
    "drizzle-orm": "^0.45.2",
    "jszip": "3.10.1",
    "lucide-react": "^1.34.0",
    "pdfjs-dist": "5.6.205",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2",
    "xlsx": "^0.18.5"
  },
  "displayName": "KOSIF | استوديو التدقيق",
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
